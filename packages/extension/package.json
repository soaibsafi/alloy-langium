{
    "name": "vscode-alloy-langium",
    "description": "The extension specific package",
    "version": "0.0.1",
    "displayName": "Alloy Language Server & Tools",
    "type": "module",
    "engines": {
        "vscode": "^1.67.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "alloy",
            "aliases": ["Alloy", "alloy"],
            "extensions": [".als"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "alloy",
            "scopeName": "source.alloy",
            "path": "syntaxes/alloy.tmLanguage.json"
        }],
        "commands": [
            {
                "command": "alloy.showModelStats",
                "title": "Alloy: Show Model Statistics & Complexity",
                "category": "Alloy",
                "icon": "$(chart-bar)"
            },
            {
                "command": "alloy.restartServer",
                "title": "Alloy: Restart Language Server",
                "category": "Alloy"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "alloy.showModelStats",
                    "when": "resourceLangId == alloy",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "alloy.showModelStats",
                    "when": "editorLangId == alloy"
                },
                {
                    "command": "alloy.restartServer"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "Alloy",
            "properties": {
                "alloy.server.maxNumberOfProblems": {
                    "scope": "resource",
                    "type": "number",
                    "default": 100,
                    "description": "Controls the maximum number of problems produced by the Alloy server."
                },
                "alloy.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": ["off", "messages", "verbose"],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the Alloy language server."
                }
            }
        }
    },
    "activationEvents": [
        "onLanguage:alloy"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/alloy.tmLanguage.json ./syntaxes/alloy.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "test": "echo \"Extension build verified\"",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "alloy-language": "0.0.1",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "~1.67.0",
        "concurrently": "~8.2.1",
        "esbuild": "~0.25.5"
    },
    "vsce": {
      "dependencies": false
    }
}
